# Copy to .env for local development (consumed by app.config.ts via `process.env`). The Expo
# app holds NO Supabase credential of any kind — only this one API base URL.
#
# For staging/production builds, this same variable is set per-profile in eas.json instead of
# from a .env file (see the "build.preview.env" / "build.production.env" entries there) — EAS
# builds don't read a local .env, so eas.json is the actual source of truth for those two
# environments; this file only matters for local `expo start` development.

API_BASE_URL=http://localhost:3000
