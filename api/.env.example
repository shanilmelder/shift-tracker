# Copy to .env for local development. Never commit the real .env file.
#
# Per specs/001-shift-scheduling-app/plan.md's Deployment Notes, every variable below points
# at a DIFFERENT value per environment:
#   - development: your own Supabase project (or a shared dev project), local .env file
#   - staging:     the staging Supabase project's URL/service-role key, set as secrets in
#                  whatever CI/hosting platform runs the staging API instance
#   - production:  the production Supabase project's URL/service-role key, set as secrets in
#                  the production hosting platform — never committed, never logged, and never
#                  present in any Expo build (the client holds no Supabase credential at all).
# There is deliberately no single "one value fits all environments" default checked in here.

NODE_ENV=development
PORT=3000

# Supabase project this API instance talks to. SUPABASE_SERVICE_ROLE_KEY is a secret:
# it must live only here, never in the Expo app, never committed, never logged.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Expo push notifications (optional in dev; required in staging/production for push to work)
EXPO_PUSH_ACCESS_TOKEN=

# Comma-separated list of allowed origins for CORS, if the Expo app is loaded via web preview
CORS_ORIGIN=*
