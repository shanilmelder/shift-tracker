# Copy to .env for local development. Never commit the real .env file.
#
# Per specs/001-shift-scheduling-app/plan.md's Deployment Notes, every variable below points
# at a DIFFERENT value per environment:
#   - development: your own Supabase project (or a shared dev project), local .env file
#   - staging:     the staging Supabase project's URL/service-role key, set as secrets in
#                  whatever CI/hosting platform runs the staging API instance
#   - production:  the production Supabase project's URL/service-role key, set as secrets in
#                  the production hosting platform — never committed, never logged, and never
#                  present in any Expo build (the client holds no Supabase credential at all).
# There is deliberately no single "one value fits all environments" default checked in here.

NODE_ENV=development
PORT=3000

# Supabase project this API instance talks to. SUPABASE_SERVICE_ROLE_KEY is a secret:
# it must live only here, never in the Expo app, never committed, never logged.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Expo push notifications (optional in dev; required in staging/production for push to work)
EXPO_PUSH_ACCESS_TOKEN=

# Comma-separated list of allowed origins for CORS, if the Expo app is loaded via web preview
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Reporting assistant (the AI chat on the manager Reports screen)
# ---------------------------------------------------------------------------
# Where the API sends chat completions. The default suits `npm run dev` on a machine running
# Ollama locally.
#
# IMPORTANT for any deployed environment: a hosted API cannot reach a developer's localhost.
# Staging/production must point this at a host the API can actually reach — https://ollama.com
# with OLLAMA_API_KEY set (required for any `-cloud` model), or a tunnel to the machine running
# the daemon. Left at the default, every assistant request fails with a 503.
OLLAMA_BASE_URL=http://localhost:11434

# Must advertise the `tools` capability — the assistant works entirely through tool calls, and
# a model without them will answer from imagination rather than from the database.
# Check with: curl http://localhost:11434/api/tags
#
# NOTE ON DATA RESIDENCY: a `-cloud` model (e.g. gpt-oss:120b-cloud) is proxied to Ollama's
# servers even when requested through a local daemon. Tool results — employee names, shift
# times, time-off records — are sent to whichever host serves the model. Use a genuinely local
# model here if that data must not leave your infrastructure.
OLLAMA_MODEL=gpt-oss:120b-cloud

# Only needed when OLLAMA_BASE_URL points at a host that authenticates (e.g. ollama.com).
OLLAMA_API_KEY=
